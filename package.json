{
  "name": "astera-official-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node site/scripts/build.mjs",
    "validate:sources": "node site/scripts/validate-source-coverage.mjs",
    "validate:content": "node site/scripts/validate-content.mjs",
    "validate:links": "node site/scripts/validate-links.mjs",
    "validate:assets": "node site/scripts/validate-assets.mjs",
    "validate:redirects": "node site/scripts/validate-redirects.mjs",
    "validate": "node site/scripts/validate.mjs",
    "test": "npm run build && npm run validate && node --test test/*.test.mjs",
    "export:notion": "node site/scripts/export-notion-content.mjs"
  }
}
